# Exemplo de variáveis de ambiente do sistema Athenas.
# Copie este arquivo para `.env` e ajuste conforme o seu ambiente.

# -----------------------------------------------------------------------------
# Dashboard (Vite / frontend)
# -----------------------------------------------------------------------------
# Endpoint WebSocket usado pelo modo "Ao vivo" do dashboard.
# Aponta para o mock-server. Variáveis lidas pelo Vite precisam do prefixo VITE_.
VITE_TELEMETRY_WS=ws://localhost:8080

# -----------------------------------------------------------------------------
# Mock-server (telemetria simulada)
# -----------------------------------------------------------------------------
# Porta em que o mock-server escuta as conexões WebSocket.
PORT=8080
